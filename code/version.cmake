# version.cmake
#
# Local replacement for the script that is missing in the upstream repository
# (upstream CI caches .pio/build/... including the generated version.cpp, so a
# clean clone cannot build without it).
#
# Invoked by CMakeLists.txt as:  cmake -P <code>/version.cmake
# It runs inside the PlatformIO build directory, so it writes the generated
# files relative to the current working directory.

set(_git_dir "${CMAKE_CURRENT_LIST_DIR}/..")

set(_tag "")
set(_rev "unknown")
set(_branch "unknown")

find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" describe --tags --abbrev=0
        WORKING_DIRECTORY "${_git_dir}"
        OUTPUT_VARIABLE _tag
        ERROR_QUIET
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse --short HEAD
        WORKING_DIRECTORY "${_git_dir}"
        OUTPUT_VARIABLE _rev
        ERROR_QUIET
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" rev-parse --abbrev-ref HEAD
        WORKING_DIRECTORY "${_git_dir}"
        OUTPUT_VARIABLE _branch
        ERROR_QUIET
        OUTPUT_STRIP_TRAILING_WHITESPACE)
endif()

string(TIMESTAMP _build_time "%Y-%m-%dT%H:%M:%S" UTC)

message(STATUS "version.cmake: tag='${_tag}' rev='${_rev}' branch='${_branch}'")

file(WRITE "version.cpp"
"// Auto-generated by version.cmake - do not edit\n\
extern \"C\" {\n\
const char* GIT_TAG    = \"${_tag}\";\n\
const char* GIT_REV    = \"${_rev}\";\n\
const char* GIT_BRANCH = \"${_branch}\";\n\
const char* BUILD_TIME = \"${_build_time}\";\n\
}\n")

# second output expected by CMakeLists.txt (kept for compatibility)
file(WRITE "_version.cpp"
"// Auto-generated by version.cmake - do not edit\n")
